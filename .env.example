# Browser: safe public settings only. Never use a service-role or OpenAI key here.
VITE_API_BASE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/api
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_FIRST_PARTY_ANALYTICS_ENABLED=false
# Optional Vercel providers: require enabling the corresponding project service.
VITE_WEB_ANALYTICS_ENABLED=false
VITE_SPEED_INSIGHTS_ENABLED=false
# Vercel custom events require Pro; first-party operation statistics do not.
VITE_ANALYTICS_CUSTOM_EVENTS=false

# Supabase Edge secrets. Use separate files for test and production.
APP_ENVIRONMENT=test
APP_PUBLIC_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
APP_SHA=development
# Optional legacy OCR; disabled in PDD404, not required for waybill service.
OCR_ENABLED=false
OPENAI_API_KEY=
WORKER_SECRET=
ADMIN_USER_IDS=
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to deployed functions.

# Operations: use only from a private environment file; never VITE_ prefixes.
SUPABASE_PROJECT_ID=
SUPABASE_DB_URL=
BACKUP_PASSWORD=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
MONITOR_SECRET=
# Set from the actual plan; update this when upgrading the database.
MONITOR_DATABASE_LIMIT_BYTES=500000000
TELEMETRY_ENABLED=false
TELEMETRY_DAILY_LIMIT=100000
